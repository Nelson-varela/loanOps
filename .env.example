# Copia este archivo a .env (que nunca se versiona) y llena los valores.

# --- AWS ---
AWS_PROFILE=loanops
# Una sola región, verificada el día 1: debe tener Bedrock KB, S3 Vectors y AgentCore (plan §4 S1)
AWS_REGION=
PROJECT_TAG=LoanOps

# --- Buckets (plan §2). Los nombres son globales: agrega un sufijo único, como el account id ---
S3_BUCKET_RAW=loanops-raw-<account-id>
S3_BUCKET_CURATED=loanops-curated-<account-id>
S3_BUCKET_DOCS=loanops-docs-<account-id>

# --- Auth (apps/, futuro · ADR-0003) ---
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
